+import { useLocalStorage } from '@/hooks/useLocalStorage';
+import { SEED_RITUALS } from '@/data/seed';
+import { getWeeklyProgress, getMonthlyProgress } from '@/data/habits';
+import type { Ritual } from '@/data/types';
+
+export function useHabits() {
+  const [rituals] = useLocalStorage<Ritual[]>('ritualflow.rituals', SEED_RITUALS);
+
+  const weeklyProgress = getWeeklyProgress(rituals, []);
+  const monthlyProgress = getMonthlyProgress(rituals, []);
+  const bestStreak =
+    rituals.length > 0 ? Math.max(...rituals.map((r) => r.bestStreak), 0) : 0;
+
+  return { weeklyProgress, monthlyProgress, bestStreak };
+}
