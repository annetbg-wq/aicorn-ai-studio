@@ -0,0 +1,89 @@
+import { CheckCircle2, Clock, Flame, ChevronRight } from 'lucide-react';
+import { Card, CardContent } from '@/components/ui/card';
+import type { Ritual } from '@/data/types';
+
+interface RitualCardProps {
+  ritual: Ritual;
+  onComplete: (id: string) => void;
+  onDetail: (id: string) => void;
+  isAnimating: boolean;
+}
+
+const CATEGORY_ICONS: Record<string, string> = {
+  physical: '💪',
+  mental: '🧠',
+  nutrition: '🥗',
+  hygiene: '🚿',
+  creativity: '🎨',
+  social: '👥',
+};
+
+export function RitualCard({ ritual, onComplete, onDetail, isAnimating }: RitualCardProps) {
+  const today = new Date().toISOString().split('T')[0];
+  const isCompleted = ritual.completedDates.includes(today);
+  const categoryIcon = CATEGORY_ICONS[ritual.category] ?? '📋';
+
+  return (
+    <Card className="bg-card rounded-[12px] overflow-hidden transition-all duration-200 hover:shadow-md">
+      <CardContent className="p-[16px]">
+        <div className="flex items-center gap-3">
+          <button
+            type="button"
+            onClick={() => onComplete(ritual.id)}
+            disabled={isCompleted || isAnimating}
+            aria-label={isCompleted ? 'Выполнено' : 'Отметить выполнение'}
+            className={`w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300 shrink-0 border-2 ${
+              isCompleted
+                ? 'bg-primary border-primary text-primary-foreground'
+                : isAnimating
+                  ? 'border-primary/50 text-primary/50'
+                  : 'border-border text-muted-foreground hover:border-primary/50 hover:text-primary/70 active:scale-95'
+            }`}
+          >
+            {isAnimating ? (
+              <span className="w-4 h-4 rounded-full border-2 border-primary border-t-transparent animate-spin block" />
+            ) : isCompleted ? (
+              <CheckCircle2 className="w-5 h-5" />
+            ) : (
+              <span className="text-lg leading-none">{categoryIcon}</span>
+            )}
+          </button>
+
+          <div className="flex-1 min-w-0">
+            <p
+              className={`font-semibold text-sm leading-tight ${
+                isCompleted ? 'line-through text-muted-foreground' : 'text-foreground'
+              }`}
+            >
+              {ritual.name}
+            </p>
+            <div className="flex items-center gap-2.5 mt-1">
+              <span className="flex items-center gap-0.5 text-xs text-muted-foreground">
+                <Clock className="w-3 h-3" />
+                {ritual.duration} мин
+              </span>
+              {ritual.streak > 0 && (
+                <span className="flex items-center gap-0.5 text-xs text-amber-500 font-medium">
+                  <Flame className="w-3 h-3" />
+                  {ritual.streak} дн
+                </span>
+              )}
+              {isCompleted && (
+                <span className="text-xs text-primary font-medium">✓ Сделано</span>
+              )}
+            </div>
+          </div>
+
+          <button
+            type="button"
+            onClick={() => onDetail(ritual.id)}
+            aria-label="Подробнее"
+            className="text-muted-foreground hover:text-foreground transition-colors p-1 rounded-md hover:bg-muted"
+          >
+            <ChevronRight className="w-4 h-4" />
+          </button>
+        </div>
+      </CardContent>
+    </Card>
+  );
+}
