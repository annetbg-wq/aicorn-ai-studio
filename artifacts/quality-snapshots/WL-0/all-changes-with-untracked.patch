+++ b/frontend/src/services/LVPipeline.ts
@@ -0,0 +1,24 @@
+import { GenerationEngine, type PipelineRunConfig } from './GenerationEngine';
+
+export interface LVPipelineEligibilityInput {
+  generationPath?: string | null;
+  existingCodeCount: number;
+}
+
+export function isBlankCanvasFastPathEligible(input: LVPipelineEligibilityInput): boolean {
+  return input.generationPath === 'blank_canvas' && input.existingCodeCount === 0;
+}
+
+export class LVPipeline {
+  static isBlankCanvasFastPathEligible = isBlankCanvasFastPathEligible;
+
+  static async run(config: PipelineRunConfig): Promise<ReturnType<typeof GenerationEngine.run> extends Promise<infer T> ? T : never> {
+    config.onLog?.('[LVPipeline] blank_canvas fast path enabled: skipping clarifier and saved-plan reuse');
+    return GenerationEngine.run({
+      ...config,
+      skipClarify: true,
+      prebuiltPlan: undefined,
+      reuseSavedPlanForContinuation: false,
+    });
+  }
+}
