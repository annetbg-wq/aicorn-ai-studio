+import { describe, expect, it, vi } from 'vitest';
+import { LVPipeline, isBlankCanvasFastPathEligible } from '../LVPipeline';
+import { GenerationEngine, type PipelineRunConfig } from '../GenerationEngine';
+
+describe('LVPipeline', () => {
+  it('detects the blank-canvas fast path only for empty projects', () => {
+    expect(isBlankCanvasFastPathEligible({
+      generationPath: 'blank_canvas',
+      existingCodeCount: 0,
+    })).toBe(true);
+
+    expect(isBlankCanvasFastPathEligible({
+      generationPath: 'blank_canvas',
+      existingCodeCount: 3,
+    })).toBe(false);
+  });
+
+  it('delegates to GenerationEngine with clarifier and saved-plan reuse disabled', async () => {
+    const runSpy = vi.spyOn(GenerationEngine, 'run').mockResolvedValue({ status: 'completed' } as any);
+
+    const config = {
+      intent: 'Build a fresh workspace',
+      history: [],
+      files: {},
+      primaryRoute: {} as any,
+      buildRoute: {} as any,
+      apiKey: 'test',
+      modelId: 'test-model',
+      onStream: vi.fn(),
+      onFiles: vi.fn(),
+      onPhase: vi.fn(),
+      onLog: vi.fn(),
+      onPlan: vi.fn(),
+      prebuiltPlan: { appName: 'Should be dropped' } as any,
+      reuseSavedPlanForContinuation: true,
+    } satisfies PipelineRunConfig;
+
+    await LVPipeline.run(config);
+
+    expect(runSpy).toHaveBeenCalledWith(expect.objectContaining({
+      skipClarify: true,
+      prebuiltPlan: undefined,
+      reuseSavedPlanForContinuation: false,
+    }));
+  });
+});
