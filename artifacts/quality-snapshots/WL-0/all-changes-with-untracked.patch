@@ -0,0 +1,82 @@
+import { useState, useCallback } from 'react';
+import { useLocalStorage } from '@/hooks/useLocalStorage';
+import { SEED_RITUALS } from '@/data/seed';
+import { calculateStreak } from '@/data/habits';
+import type { Ritual } from '@/data/types';
+
+interface AddRitualInput {
+  name: string;
+  category: string;
+  duration: number;
+}
+
+export function useRituals() {
+  const [rituals, setRituals] = useLocalStorage<Ritual[]>('ritualflow.rituals', SEED_RITUALS);
+  const [animatingId, setAnimatingId] = useState<string | null>(null);
+
+  const today = new Date().toISOString().split('T')[0];
+
+  const completeRitual = useCallback((id: string) => {
+    setAnimatingId(id);
+    setTimeout(() => {
+      setRituals((prev) =>
+        prev.map((r) => {
+          if (r.id !== id) return r;
+          if (r.completedDates.includes(today)) return r;
+          const completedDates = [...r.completedDates, today];
+          const updated = { ...r, completedDates };
+          const streak = calculateStreak(updated);
+          return { ...updated, streak, bestStreak: Math.max(streak, r.bestStreak) };
+        }),
+      );
+      setAnimatingId(null);
+    }, 500);
+  }, [today, setRituals]);
+
+  const addRitual = useCallback(
+    (input: AddRitualInput) => {
+      const newRitual: Ritual = {
+        id: `ritual-${Date.now()}`,
+        name: input.name,
+        category: input.category,
+        duration: input.duration,
+        completedDates: [],
+        recommendations: [],
+        createdAt: new Date().toISOString(),
+        streak: 0,
+        bestStreak: 0,
+      };
+      setRituals((prev) => [...prev, newRitual]);
+    },
+    [setRituals],
+  );
+
+  const removeRitual = useCallback(
+    (id: string) => {
+      setRituals((prev) => prev.filter((r) => r.id !== id));
+    },
+    [setRituals],
+  );
+
+  const getRitualById = useCallback(
+    (id: string): Ritual | null => rituals.find((r) => r.id === id) ?? null,
+    [rituals],
+  );
+
+  const todayCompleted = rituals.filter((r) => r.completedDates.includes(today)).length;
+  const totalRituals = rituals.length;
+  const currentStreak =
+    rituals.length > 0 ? Math.max(...rituals.map((r) => r.streak), 0) : 0;
+
+  return {
+    rituals,
+    animatingId,
+    todayCompleted,
+    totalRituals,
+    currentStreak,
+    completeRitual,
+    addRitual,
+    removeRitual,
+    getRitualById,
+  };
+}
