+  const verdict = result.verdict === 'revise' ? 'revise' : 'pass';
+  return {
+    verdict,
+    reasons: Array.isArray(result.reasons)
+      ? result.reasons.filter((item): item is string => typeof item === 'string').slice(0, 6)
+      : [],
+    instructions: Array.isArray(result.instructions)
