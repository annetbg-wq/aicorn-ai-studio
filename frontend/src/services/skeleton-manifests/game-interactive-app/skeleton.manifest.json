{
  "version": 2,
  "id": "game-interactive-app",
  "label": "Interactive Game App",
  "workingGroups": [
    {
      "label": "core",
      "paths": [
        "src/App.tsx",
        "src/main.tsx",
        "src/index.css",
        "src/route-manifest.json"
      ]
    },
    {
      "label": "config",
      "paths": [
        "src/config/app.ts",
        "src/config/navigation.ts",
        "src/config/routes.ts",
        "src/config/theme.ts"
      ]
    },
    {
      "label": "context",
      "paths": [
        "src/context/AppContext.tsx"
      ]
    },
    {
      "label": "hooks",
      "paths": [
        "src/hooks/useLocalStorage.ts",
        "src/hooks/useTheme.ts"
      ]
    },
    {
      "label": "data",
      "paths": [
        "src/data/seed.ts",
        "src/data/types.ts"
      ]
    },
    {
      "label": "components",
      "paths": [
        "src/components/BottomTabs.tsx",
        "src/components/EmptyState.tsx",
        "src/components/ErrorBoundary.tsx",
        "src/components/LevelCard.tsx",
        "src/components/LoadingScreen.tsx",
        "src/components/PageHeader.tsx"
      ]
    },
    {
      "label": "ui",
      "paths": [
        "src/components/ui/Badge.tsx",
        "src/components/ui/Button.tsx",
        "src/components/ui/Card.tsx",
        "src/components/ui/Input.tsx",
        "src/components/ui/Progress.tsx",
        "src/components/ui/Tabs.tsx",
        "src/components/ui/scroll-area.tsx"
      ]
    },
    {
      "label": "runtime",
      "paths": [
        "src/lib/cn.ts"
      ]
    },
    {
      "label": "pages",
      "paths": [
        "src/pages/Achievements.tsx",
        "src/pages/GameScreen.tsx",
        "src/pages/Home.tsx",
        "src/pages/Leaderboard.tsx",
        "src/pages/LevelSelect.tsx",
        "src/pages/Profile.tsx"
      ]
    }
  ],
  "ownership": {
    "skeletonOwned": [
      "src/main.tsx",
      "src/index.css",
      "src/lib/**",
      "src/hooks/**",
      "src/context/**",
      "src/components/**",
      "src/config/routes.ts",
      "src/config/theme.ts"
    ],
    "requiredProductSlots": [
      "src/config/app.ts",
      "src/config/navigation.ts",
      "src/data/types.ts",
      "src/data/seed.ts",
      "src/pages/Achievements.tsx",
      "src/pages/GameScreen.tsx",
      "src/pages/Home.tsx",
      "src/pages/Leaderboard.tsx",
      "src/pages/LevelSelect.tsx",
      "src/pages/Profile.tsx"
    ],
    "optionalProductSlots": [],
    "agentEditable": [
      "src/config/app.ts",
      "src/config/navigation.ts",
      "src/data/types.ts",
      "src/data/seed.ts",
      "src/pages/Achievements.tsx",
      "src/pages/GameScreen.tsx",
      "src/pages/Home.tsx",
      "src/pages/Leaderboard.tsx",
      "src/pages/LevelSelect.tsx",
      "src/pages/Profile.tsx"
    ],
    "agentReadOnly": [
      "src/main.tsx",
      "src/index.css",
      "src/lib/**",
      "src/hooks/**",
      "src/context/**",
      "src/components/**",
      "src/config/routes.ts",
      "src/config/theme.ts"
    ],
    "carcassFiles": []
  },
  "protectedFiles": [
    "src/main.tsx",
    "src/index.css",
    "src/lib/**",
    "src/hooks/**",
    "src/context/**",
    "src/components/**",
    "src/config/routes.ts",
    "src/config/theme.ts"
  ],
  "requiredExports": {},
  "qualityContract": {
    "minMeaningfulScreens": 4,
    "requiredCapabilities": [
      "home",
      "level-select",
      "playable-surface",
      "leaderboard"
    ],
    "requiredFlows": [
      "home-to-level",
      "level-to-gameplay"
    ]
  },
  "selectionContract": {
    "productTypes": [
      "interactive-game"
    ],
    "surfaces": [
      "home",
      "level-select",
      "gameplay",
      "leaderboard"
    ],
    "capabilities": [
      "playable-surface",
      "progression",
      "score"
    ],
    "incompatibleArchetypes": [
      "dashboard",
      "marketing",
      "commerce"
    ]
  }
}
