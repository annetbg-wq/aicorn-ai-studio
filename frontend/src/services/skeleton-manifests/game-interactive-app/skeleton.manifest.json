{
  "version": 1,
  "id": "game-interactive-app",
  "label": "Interactive Game App",
  "workingGroups": [
    { "label": "core", "paths": ["src/App.tsx", "src/main.tsx", "src/index.css", "src/route-manifest.json"] },
    { "label": "config", "paths": ["src/config/app.ts", "src/config/navigation.ts", "src/config/routes.ts", "src/config/theme.ts"] },
    { "label": "context", "paths": ["src/context/AppContext.tsx"] },
    { "label": "hooks", "paths": ["src/hooks/useLocalStorage.ts", "src/hooks/useTheme.ts"] },
    { "label": "data", "paths": ["src/data/seed.ts", "src/data/types.ts"] },
    { "label": "components", "paths": ["src/components/BottomTabs.tsx", "src/components/EmptyState.tsx", "src/components/ErrorBoundary.tsx", "src/components/LevelCard.tsx", "src/components/LoadingScreen.tsx", "src/components/PageHeader.tsx"] },
    { "label": "ui", "paths": ["src/components/ui/Badge.tsx", "src/components/ui/Button.tsx", "src/components/ui/Card.tsx", "src/components/ui/Input.tsx", "src/components/ui/Progress.tsx", "src/components/ui/Tabs.tsx", "src/components/ui/scroll-area.tsx"] },
    { "label": "runtime", "paths": ["src/lib/cn.ts"] },
    { "label": "pages", "paths": ["src/pages/Achievements.tsx", "src/pages/GameScreen.tsx", "src/pages/Home.tsx", "src/pages/Leaderboard.tsx", "src/pages/LevelSelect.tsx", "src/pages/Profile.tsx"] }
  ],
  "protectedFiles": [
    "src/main.tsx",
    "src/index.css",
    "src/lib/**",
    "src/hooks/**",
    "src/context/**",
    "src/components/**",
    "src/config/routes.ts",
    "src/config/theme.ts"
  ],
  "editableFiles": [
    "src/config/app.ts",
    "src/config/navigation.ts",
    "src/data/types.ts",
    "src/data/seed.ts",
    "src/pages/Achievements.tsx",
    "src/pages/GameScreen.tsx",
    "src/pages/Home.tsx",
    "src/pages/Leaderboard.tsx",
    "src/pages/LevelSelect.tsx",
    "src/pages/Profile.tsx"
  ],
  "deltaFiles": [
    "src/config/app.ts",
    "src/config/navigation.ts",
    "src/data/types.ts",
    "src/data/seed.ts",
    "src/pages/Achievements.tsx",
    "src/pages/GameScreen.tsx",
    "src/pages/Home.tsx",
    "src/pages/Leaderboard.tsx",
    "src/pages/LevelSelect.tsx",
    "src/pages/Profile.tsx"
  ],
  "requiredExports": {
    "data/seed.ts": [
      { "name": "levels" },
      { "name": "achievements" },
      { "name": "leaderboard" }
    ],
    "data/types.ts": [
      { "name": "Level" },
      { "name": "Achievement" },
      { "name": "LeaderboardEntry" }
    ],
    "config/app.ts": [
      { "name": "appConfig" }
    ],
    "config/navigation.ts": [
      { "name": "navigationItems" }
    ]
  }
}
