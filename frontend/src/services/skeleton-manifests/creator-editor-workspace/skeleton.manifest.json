{
  "version": 2,
  "id": "creator-editor-workspace",
  "label": "Creator Editor Workspace",
  "workingGroups": [
    {
      "label": "core",
      "paths": [
        "src/App.tsx",
        "src/main.tsx",
        "src/index.css",
        "src/route-manifest.json"
      ]
    },
    {
      "label": "config",
      "paths": [
        "src/config/app.ts",
        "src/config/navigation.ts",
        "src/config/routes.ts",
        "src/config/theme.ts"
      ]
    },
    {
      "label": "context",
      "paths": [
        "src/context/AppContext.tsx"
      ]
    },
    {
      "label": "hooks",
      "paths": [
        "src/hooks/useLocalStorage.ts",
        "src/hooks/useTheme.ts"
      ]
    },
    {
      "label": "data",
      "paths": [
        "src/data/seed.ts",
        "src/data/types.ts"
      ]
    },
    {
      "label": "components",
      "paths": [
        "src/components/DraftCard.tsx",
        "src/components/EmptyState.tsx",
        "src/components/ErrorBoundary.tsx",
        "src/components/LoadingScreen.tsx",
        "src/components/PageHeader.tsx",
        "src/components/Sidebar.tsx"
      ]
    },
    {
      "label": "ui",
      "paths": [
        "src/components/ui/Badge.tsx",
        "src/components/ui/Button.tsx",
        "src/components/ui/Card.tsx",
        "src/components/ui/Input.tsx",
        "src/components/ui/Progress.tsx",
        "src/components/ui/Tabs.tsx",
        "src/components/ui/scroll-area.tsx"
      ]
    },
    {
      "label": "runtime",
      "paths": [
        "src/lib/cn.ts"
      ]
    },
    {
      "label": "pages",
      "paths": [
        "src/pages/Analytics.tsx",
        "src/pages/Editor.tsx",
        "src/pages/Home.tsx",
        "src/pages/Media.tsx",
        "src/pages/Publications.tsx",
        "src/pages/Settings.tsx"
      ]
    }
  ],
  "ownership": {
    "skeletonOwned": [
      "src/main.tsx",
      "src/index.css",
      "src/lib/**",
      "src/hooks/**",
      "src/context/**",
      "src/components/**",
      "src/config/routes.ts",
      "src/config/theme.ts"
    ],
    "requiredProductSlots": [
      "src/config/app.ts",
      "src/config/navigation.ts",
      "src/data/types.ts",
      "src/data/seed.ts",
      "src/pages/Analytics.tsx",
      "src/pages/Editor.tsx",
      "src/pages/Home.tsx",
      "src/pages/Media.tsx",
      "src/pages/Publications.tsx",
      "src/pages/Settings.tsx"
    ],
    "optionalProductSlots": [],
    "agentEditable": [
      "src/config/app.ts",
      "src/config/navigation.ts",
      "src/data/types.ts",
      "src/data/seed.ts",
      "src/pages/Analytics.tsx",
      "src/pages/Editor.tsx",
      "src/pages/Home.tsx",
      "src/pages/Media.tsx",
      "src/pages/Publications.tsx",
      "src/pages/Settings.tsx"
    ],
    "agentReadOnly": [
      "src/main.tsx",
      "src/index.css",
      "src/lib/**",
      "src/hooks/**",
      "src/context/**",
      "src/components/**",
      "src/config/routes.ts",
      "src/config/theme.ts"
    ],
    "carcassFiles": []
  },
  "protectedFiles": [
    "src/main.tsx",
    "src/index.css",
    "src/lib/**",
    "src/hooks/**",
    "src/context/**",
    "src/components/**",
    "src/config/routes.ts",
    "src/config/theme.ts"
  ],
  "requiredExports": {},
  "qualityContract": {
    "minMeaningfulScreens": 4,
    "requiredCapabilities": [
      "project-home",
      "editor",
      "media",
      "publishing"
    ],
    "requiredFlows": [
      "home-to-editor",
      "editor-to-publication"
    ]
  },
  "selectionContract": {
    "productTypes": [
      "creator-tool"
    ],
    "surfaces": [
      "editor",
      "canvas",
      "media",
      "publications"
    ],
    "capabilities": [
      "editing",
      "assets",
      "publishing"
    ],
    "incompatibleArchetypes": [
      "marketing",
      "dating",
      "commerce"
    ]
  }
}
