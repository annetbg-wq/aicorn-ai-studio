{
  "version": 2,
  "id": "gaming-casino-app",
  "label": "Gaming Casino App",
  "workingGroups": [
    {
      "label": "core",
      "paths": [
        "src/App.tsx",
        "src/main.tsx",
        "src/index.css",
        "src/route-manifest.json"
      ]
    },
    {
      "label": "config",
      "paths": [
        "src/config/app.ts",
        "src/config/navigation.ts",
        "src/config/routes.ts",
        "src/config/theme.ts"
      ]
    },
    {
      "label": "context",
      "paths": [
        "src/context/AppContext.tsx"
      ]
    },
    {
      "label": "hooks",
      "paths": [
        "src/hooks/useLocalStorage.ts",
        "src/hooks/useTheme.ts"
      ]
    },
    {
      "label": "data",
      "paths": [
        "src/data/seed.ts",
        "src/data/types.ts"
      ]
    },
    {
      "label": "components",
      "paths": [
        "src/components/BottomTabs.tsx",
        "src/components/EmptyState.tsx",
        "src/components/ErrorBoundary.tsx",
        "src/components/GameCard.tsx",
        "src/components/LoadingScreen.tsx",
        "src/components/PageHeader.tsx"
      ]
    },
    {
      "label": "ui",
      "paths": [
        "src/components/ui/Badge.tsx",
        "src/components/ui/Button.tsx",
        "src/components/ui/Card.tsx",
        "src/components/ui/Input.tsx",
        "src/components/ui/Progress.tsx",
        "src/components/ui/Tabs.tsx",
        "src/components/ui/scroll-area.tsx"
      ]
    },
    {
      "label": "runtime",
      "paths": [
        "src/lib/cn.ts"
      ]
    },
    {
      "label": "pages",
      "paths": [
        "src/pages/Account.tsx",
        "src/pages/GameDetail.tsx",
        "src/pages/Games.tsx",
        "src/pages/Leaderboard.tsx",
        "src/pages/Lobby.tsx",
        "src/pages/Promotions.tsx",
        "src/pages/ResponsibleGaming.tsx"
      ]
    }
  ],
  "ownership": {
    "skeletonOwned": [
      "src/main.tsx",
      "src/index.css",
      "src/lib/**",
      "src/hooks/**",
      "src/context/**",
      "src/components/**",
      "src/config/routes.ts",
      "src/config/theme.ts"
    ],
    "requiredProductSlots": [
      "src/config/app.ts",
      "src/config/navigation.ts",
      "src/data/types.ts",
      "src/data/seed.ts",
      "src/pages/Account.tsx",
      "src/pages/GameDetail.tsx",
      "src/pages/Games.tsx",
      "src/pages/Leaderboard.tsx",
      "src/pages/Lobby.tsx",
      "src/pages/Promotions.tsx",
      "src/pages/ResponsibleGaming.tsx"
    ],
    "optionalProductSlots": [],
    "agentEditable": [
      "src/config/app.ts",
      "src/config/navigation.ts",
      "src/data/types.ts",
      "src/data/seed.ts",
      "src/pages/Account.tsx",
      "src/pages/GameDetail.tsx",
      "src/pages/Games.tsx",
      "src/pages/Leaderboard.tsx",
      "src/pages/Lobby.tsx",
      "src/pages/Promotions.tsx",
      "src/pages/ResponsibleGaming.tsx"
    ],
    "agentReadOnly": [
      "src/main.tsx",
      "src/index.css",
      "src/lib/**",
      "src/hooks/**",
      "src/context/**",
      "src/components/**",
      "src/config/routes.ts",
      "src/config/theme.ts"
    ],
    "carcassFiles": []
  },
  "protectedFiles": [
    "src/main.tsx",
    "src/index.css",
    "src/lib/**",
    "src/hooks/**",
    "src/context/**",
    "src/components/**",
    "src/config/routes.ts",
    "src/config/theme.ts"
  ],
  "requiredExports": {},
  "qualityContract": {
    "minMeaningfulScreens": 4,
    "requiredCapabilities": [
      "lobby",
      "game-browser",
      "game-detail",
      "account"
    ],
    "requiredFlows": [
      "lobby-to-game",
      "game-to-detail"
    ]
  },
  "selectionContract": {
    "productTypes": [
      "gaming"
    ],
    "surfaces": [
      "lobby",
      "games",
      "game-detail",
      "promotions",
      "account"
    ],
    "capabilities": [
      "game-browser",
      "promotions",
      "account"
    ],
    "incompatibleArchetypes": [
      "dashboard",
      "marketing",
      "creator-tool"
    ]
  }
}
