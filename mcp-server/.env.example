# Copy to .env for local development. Never commit real values — this file
# stays as a placeholder template only.

PORT=8787
HOST=127.0.0.1

# Bearer token the MCP client must send as `Authorization: Bearer <value>`.
# Generate your own, e.g. `openssl rand -hex 32`.
MCP_BEARER_TOKEN=

GITHUB_OWNER=annetbg-wq
GITHUB_REPO=aicorn-ai-studio
# Fine-grained PAT scoped to ONLY this repo: Contents (read/write),
# Pull requests (read/write), Actions (read/write), Workflows (read/write).
GITHUB_TOKEN=

SUPABASE_URL=
# Project Settings -> API -> service_role key. Bypasses RLS — never expose this.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> Database -> Connection string (used for schema/migration/query tools).
SUPABASE_DB_URL=

# Account Settings -> API Keys.
RENDER_API_KEY=
# Optional — deploy_* tools look the backend service up by name if unset.
RENDER_BACKEND_SERVICE_ID=

BACKEND_HEALTH_URL=https://aicorn-ai-studio-backend.onrender.com/health
PAGES_URL=https://annetbg-wq.github.io/aicorn-ai-studio/

# Optional — this service's own externally-reachable base URL, used in OAuth
# discovery metadata (issuer/authorization_endpoint/token_endpoint). On Render
# this is auto-derived from RENDER_EXTERNAL_URL (always set there automatically)
# — only set this for local dev, e.g. http://localhost:8787.
PUBLIC_BASE_URL=
