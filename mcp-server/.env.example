# Copy to .env for local development. Never commit real values.

PORT=8787
HOST=127.0.0.1

# Always required for MCP authentication/OAuth signing.
MCP_BEARER_TOKEN=

GITHUB_OWNER=annetbg-wq
GITHUB_REPO=aicorn-ai-studio
# Optional capability: enables MCP-internal repo/CI tools.
# Fine-grained PAT scoped only to this repo.
GITHUB_TOKEN=

# Optional capabilities for MCP-internal Supabase and live pipeline diagnostics.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Optional capability: enables MCP-internal Railway deploy/status/log/env-key tools.
# Use a Railway PROJECT token scoped to the production environment, not an account token.
RAILWAY_PROJECT_TOKEN=
# Railway injects RAILWAY_PROJECT_ID and RAILWAY_ENVIRONMENT_ID in production.
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
# Explicit sibling backend service operated by this MCP.
RAILWAY_BACKEND_SERVICE_ID=

# Optional explicit override. In Railway this can be omitted: the MCP derives the
# backend from Railway's cross-service URL and finally falls back to the current
# public Railway backend URL.
BACKEND_HEALTH_URL=
PAGES_URL=https://annetbg-wq.github.io/aicorn-ai-studio/

# Optional for local dev or an intentional custom domain. Railway production
# derives this from RAILWAY_PUBLIC_DOMAIN automatically.
PUBLIC_BASE_URL=

# RENDER_EXTERNAL_URL may still be recognized automatically by old deployments as
# a passive public-base-url fallback. There is no Render API credential or deploy control anymore.
