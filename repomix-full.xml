      <div style={{ position: 'relative', width: '100%', maxWidth: 1100, margin: '0 16px', background: '#0a0a0c', borderRadius: 28, border: '1px solid rgba(255,255,255,0.1)', overflow: 'hidden', boxShadow: '0 25px 50px -12px rgba(0,0,0,0.5)' }}>
        
