                style={{ padding: '10px 13px', borderRadius: 11, background: '#111114', border: '1px solid rgba(255,255,255,0.07)', color: '#fff', fontSize: 12, outline: 'none', minHeight: 72, fontFamily: 'inherit', resize: 'vertical' }}
