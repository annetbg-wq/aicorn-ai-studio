      {/* ━━ BODY ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */}
      <div style={{ flex: 1, display: 'flex', overflow: 'hidden' }}>

        {/* ══ LEFT PANEL ═══════════════════════════════════════════════════ */}
        <div style={{ width: 300, flexShrink: 0, background: c.panel, borderRight: `1px solid ${c.border}`, display: 'flex', flexDirection: 'column', overflowY: 'auto' }}>

