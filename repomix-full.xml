                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* ── Clear archive button ── */}
          {archiveSessions.length > 0 && (
            <button
              onClick={() => void handleClearArchive()}
              disabled={isCleaningArchive}
              style={{ ...btn(isCleaningArchive ? '#a87171' : '#f87171', 'rgba(248,113,113,0.08)'), opacity: isCleaningArchive ? 0.6 : 1 }}
            >
