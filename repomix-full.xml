                style={{ ...btn(
                  taskDescription.trim() && !launching ? (isSuggestedFix ? '#f59e0b' : '#60a5fa') : '#444',
                  taskDescription.trim() && !launching ? (isSuggestedFix ? 'rgba(245,158,11,0.18)' : 'rgba(96,165,250,0.18)') : 'rgba(255,255,255,0.03)',
