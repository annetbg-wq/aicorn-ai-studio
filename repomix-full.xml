// ── Types ──────────────────────────────────────────────────────────────────

export interface IdeaPlan extends ProjectPlan {
  id:             string;
  marketContext:  string;
  targetAudience: string;
  painPoint:      string;
  competitorGap:  string;
  generatedAt:    string;
}

interface BankItem {
  ideaPlan: IdeaPlan;
  savedAt:  string;
