                  style={{
                    padding: '4px 10px', borderRadius: 7, border: `1px solid ${gateSuite === s ? 'rgba(96,165,250,0.5)' : 'rgba(255,255,255,0.07)'}`,
                    background: gateSuite === s ? 'rgba(96,165,250,0.12)' : 'transparent',
