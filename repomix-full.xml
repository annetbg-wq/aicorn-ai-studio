              <button
                onClick={() => void handleRunGate()}
                disabled={gateRunning || !specApiKey && !buildApiKey}
                style={{ ...btn(
                  gateRunning ? '#555' : '#a78bfa',
                  gateRunning ? 'rgba(255,255,255,0.03)' : 'rgba(167,139,250,0.15)',
