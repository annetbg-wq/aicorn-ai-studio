      )}

      {/* ── Camera + Score ── */}
      <div style={{ display: 'flex', gap: 12, marginBottom: 14, flexWrap: 'wrap' }}>

        {/* Camera frame */}
        <div style={{
          flex: '1 1 180px', minHeight: 150,
