/**
 * SimpleGeneration — self-contained generation service.
 *
 * Writes files directly to preview-app/src/ via /__write_preview endpoint.
 * Vite HMR on port 3100 picks up changes automatically.
 * No sandbox, no revisions, no bootstrap, no materialization.
 */

import { llmFetchStream, llmFetch } from './LLMProxy';
import { ConfigService } from './ConfigService';
import type { AgentSlot } from './ConfigService';
import { Orchestrator } from './Orchestrator';
import type {
  ChatMessage,
  FileOperation,
  PhaseEvent,
  UsageData,
  AgentPhase,
} from '../shared/projectModel';
import type {
  GenerationResult,
  ProjectGraph,
  ChangePackage,
  FileBlueprint,
  ProductManifest,
} from '../shared/projectModel';
import { GenerationQualityService } from './benchmark/GenerationQualityService';

// ─── Types ──────────────────────────────────────────────────────────────────

/** Architect plan schema — generated by Architect LLM or pre-built by WeeklyFeed. */
export interface ProjectPlan {
  appName:        string;
  description:    string;
  theme:          string;
  targetUser?:    string;
  layout: {
    type:       string;
    navigation: string;
  };
  uxPatterns?: {
    emptyStates:      boolean;
    loadingSkeletons?: boolean;
    searchAndFilter?:  boolean;
    onboarding?:       boolean;
    swipeActions?:     boolean;
  };
  responsiveness?: {
    primaryDevice: string;
    mobileFirst?:  boolean;
  };
  pages: Array<{
    path:         string;
    name:         string;
    file:         string;
    purpose:      string;
    isMainScreen: boolean;
    showInNav?:   boolean;
    guard?:       string | { type: string; redirectTo?: string };
    uiSpec?:      string;
    keyElements?: string[];
  }>;
  dataModel?: {
    entities:     Array<{ name: string; fields: string }>;
    sharedState?: string;
  };
  criticalUiRules?: string[];
  shadcnComponents: string[];
  icons:            string[];
  [key: string]: unknown; // allow extra fields from IdeaPlan
}

export interface PipelineRunConfig {
  intent:         string;
  history:        ChatMessage[];
  files:          Record<string, string>;
  apiKey:         string;
  modelId:        string;
  fixModelId?:    string;
  onStream:       (text: string) => void;
  onFiles:        (ops: FileOperation[]) => void;
  onPhase:        (e: PhaseEvent) => void;
  onLog:          (msg: string) => void;
  onPlan:         (steps: string[], appName?: string) => void;
  onPlanReady?:   (data: {
    plan:          object;
    blueprintText: string;
    technicalBlueprint?: object | null;
    appName:       string;
    theme:         string;
    pages:         string[];
  }) => void;
  waitForConfirmation?: (plan: object) => Promise<boolean>;
  signal?:        AbortSignal;
  onUsage?:       (data: UsageData) => void;
  language?:      string;
  maxIterations?: number;
  projectId?:     string;
  revisionId?:    string;
  singlePageSafeMode?: boolean;
  generationMode?: 'landing' | 'app' | 'superapp';
  prebuiltPlan?:  ProjectPlan;
  attachments?: Array<{
    type: string;           // 'image' | 'text' | 'code' | 'pdf'
    name: string;
    data: string;           // data URI for images/PDFs, raw text for others
    mimeType: string;
    textContent?: string;   // pre-extracted text for PDFs
  }>;
  [key: string]: unknown;
}

// ─── Architect Prompt (Step 1 — planning only) ─────────────────────────────

const ARCHITECT_PROMPT_LANDING = `You are a web developer designing a landing page.
Output ONLY valid JSON. No markdown.

{
  "appName": "...",
  "theme": "dark-slate|trust|warm|neon|bloom",
  "layout": { "type": "single", "navigation": "none" },
  "pages": [{ "path": "/", "name": "App", "file": "App.tsx", "purpose": "...", "isMainScreen": true, "keyElements": [...] }],
  "shadcnComponents": [...],
  "icons": [...]
}

Keep it simple: 1 page, no routing, hero + features + CTA.`;

const ARCHITECT_PROMPT = `You are a top-tier product founder, UX strategist, and software architect.

Your job: transform a vague app idea into a sharp, implementation-ready product plan.
Think like someone shipping a real MVP that users can understand, use, and return to.

A developer will implement what you specify.
Your output becomes the product plan.

STEP 1 — THINKING (write inside <thinking> tags)

Think in this order:

1. USER CONTEXT
- Who is the user?
- What happened right before they opened this app?
- What exact problem are they trying to solve today?
- What would make the first session feel immediately valuable?

2. PRODUCT STRATEGY
- What is the ONE core action this app enables?
- What makes the app worth reopening tomorrow or next week?
- Is there a real business model here, or should this MVP stay free?
- If monetized, what is the natural premium moment?

3. INFORMATION ARCHITECTURE
- What are the minimum screens needed for a useful MVP?
- What should the user see first?
- What belongs in navigation, and what should stay off-navigation?
- Does this app truly need onboarding, settings, auth, or premium gating?

4. DATA & STATE
- What data entities exist?
- What must persist locally?
- Does the app need realistic seed data on first launch?
- What empty states or edge cases must be designed intentionally?

5. RESPONSIVE PRODUCT SHAPE
- Is this primarily mobile, desktop, or tablet?
- Should navigation be bottom tabs, sidebar, top nav, stepper, or none?
- How should the same product adapt across screen sizes?

After </thinking>, output ONLY valid JSON. No markdown. No explanation.

Use this schema exactly:

{
  "appName": "Specific product name",
  "description": "One sentence value proposition",
  "theme": "dark-slate|trust|warm|neon|bloom",
  "targetUser": "Specific user, context, and pain point",

  "productStrategy": {
    "coreAction": "The single most important recurring user action",
    "retentionLoop": "Why the user comes back",
    "businessModel": "free|freemium|subscription|one-time",
    "paywall": {
      "needed": false,
      "trigger": "What event naturally triggers premium consideration",
      "lockedFeature": "What is premium",
      "upgradeMessage": "Benefit-focused upgrade copy",
      "surface": "modal|page|inline"
    }
  },

  "userJourney": {
    "onboarding": {
      "needed": false,
      "reason": "Why onboarding is or is not needed",
      "steps": [
        {
          "question": "Question text",
          "type": "single-choice|multi-choice|text-input|date-picker",
          "options": ["Option 1", "Option 2"],
          "storesIn": "userProfile.someField"
        }
      ],
      "completionAction": "What happens after onboarding finishes"
    },
    "firstSession": "What the user sees and does in the first 3–5 minutes",
    "returningSession": "What the user sees when they return later"
  },

  "layout": {
    "type": "single|tabs|sidebar|dashboard|wizard",
    "navigation": "none|top-nav|bottom-tabs|sidebar|stepper",
    "primaryColor": "Emotional color direction"
  },

  "pages": [
    {
      "path": "/",
      "name": "Home",
      "file": "pages/Home.tsx",
      "purpose": "What the user accomplishes here",
      "isMainScreen": true,
      "showInNav": true,
      "guard": {
        "type": "none|requires-onboarding|guest-only|premium-only",
        "redirectTo": "/onboarding"
      },
      "uiSpec": "90–140 words. Describe the page top-to-bottom: header, sections, primary action, empty state, interaction details, and mobile behavior."
    }
  ],

  "authFlow": {
    "type": "none|local-only|supabase",
    "reason": "Why auth is or is not needed for this MVP",
    "localFirst": true,
    "comment": "Prefer local-first MVP unless real multi-device identity is necessary"
  },

  "dataModel": {
    "entities": [
      {
        "name": "EntityName",
        "fields": "id: string, title: string, createdAt: string"
      }
    ],
    "seedData": {
      "needed": true,
      "reason": "Why seed data is needed or not needed",
      "examples": [
        "3 realistic domain-specific sample items"
      ]
    },
    "sharedState": "What should live in App.tsx or shared context"
  },

  "uxPatterns": {
    "emptyStates": true,
    "loadingSkeletons": false,
    "searchAndFilter": false,
    "onboarding": false,
    "swipeActions": false,
    "pullToRefresh": false,
    "hapticFeedback": false,
    "animations": "none|subtle|playful"
  },

  "responsiveness": {
    "primaryDevice": "mobile|desktop|tablet",
    "mobileFirst": true,
    "maxWidth": "max-w-md|max-w-2xl|max-w-6xl"
  },

  "criticalUiRules": [
    "All dropdowns use shadcn Select",
    "All overlays use shadcn Dialog or Sheet",
    "Every list has a meaningful empty state"
  ],

  "shadcnComponents": ["Button", "Card", "Input"],
  "icons": ["Home", "Settings", "Plus"]
}

CRITICAL RULES:

1. onboarding.needed = true ONLY if user input meaningfully changes the experience.
   If onboarding is needed, uxPatterns.onboarding must also be true.
   If onboarding is not needed, skip it and show value immediately.

2. Do NOT force a settings page for very small utilities.
   Include Settings only if the product has preferences, profile data, subscription state,
   or meaningful user controls.

3. Do NOT force authentication.
   Default to local-only or none unless real account identity is necessary.

4. Do NOT force a paywall.
   paywall.needed = true only if there is a natural premium boundary.
   If paywall.surface = "modal", do not invent a separate paywall page.
   If paywall.surface = "page", include that page in pages[].

5. seedData.needed = true for apps with lists, feeds, dashboards, logs, or content surfaces.
   Seed data must be realistic and domain-specific.

6. pages[] should usually contain 3–6 screens for a normal MVP app.
   Only go beyond that if clearly justified by the product.

7. The first page in pages[] should be the initial entry route for the MVP:
   /onboarding if onboarding is required, otherwise the main usable screen.

8. guard must be semantic JSON, not code strings.
   The Coder will translate guard logic into implementation.

9. uiSpec must be concrete and implementation-friendly, but not bloated.
   Prefer sharp specificity over long prose.

10. Think like a product leader:
   define the minimum product that feels intentional, alive, and worth reopening.

THEME SELECTION:
  dark-slate = focus, work, analytics, pro tools
  trust = health, education, finance, safety
  warm = food, travel, lifestyle, comfort
  neon = gaming, music, creator, youth energy
  bloom = wellness, care, family, growth
`;

// ─── Architect Prompt — SUPERAPP (Momna-level full architecture) ────────────

const ARCHITECT_PROMPT_SUPERAPP = `You are a world-class product architect. Your job: take a vague idea and produce a COMPLETE, Momna-level file architecture that a developer can implement file by file.

REFERENCE — Momna (real Lovable project, pregnancy tracker):
  contexts/UserContext.tsx       — global state, types, localStorage persistence
  data/weeklyContent.ts          — 120 records of weekly content
