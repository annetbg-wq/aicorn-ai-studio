    repairHints: [],
  };
}

/**
 * Normalise LLM file paths to the `src/`-prefixed keys that
 * the code editor expects.
 */
function toSrcKey(path: string): string {
  let p = path.startsWith('/') ? path.slice(1) : path;
  if (!p.startsWith('src/')) p = 'src/' + p;
  return p;
}

// ─── LLM Call Helper ────────────────────────────────────────────────────────

type ModelSlot = 'primary' | 'build' | 'fix';

async function callLLM(
  systemPrompt: string,
  userMessage: string,
  slot: ModelSlot,
  fallbackApiKey: string,
  onStream?: (text: string) => void,
  signal?: AbortSignal,
  maxTokensOverride?: number,
): Promise<string> {
  const modelId = ConfigService.resolveModel(slot as AgentSlot);
  const apiKey = ConfigService.getKeyForAgent(slot as AgentSlot) || fallbackApiKey;

  // Resolve endpoint from the agent's configured provider
  const agentKey = slot === 'primary' ? 'agent_primary' : slot === 'build' ? 'agent_build' : 'agent_fix';
  const provider = ConfigService.getAgentConfig(agentKey).provider || 'openrouter';
  const endpoint = Orchestrator.getEndpoint(provider);

  const messages = [
    { role: 'system', content: systemPrompt },
    { role: 'user', content: userMessage },
  ];

  const body = JSON.stringify({
    model: modelId,
    messages,
    stream: true,
    temperature: 0.3,
    max_tokens: maxTokensOverride ?? (slot === 'build' ? 32000 : 4000),
  });

  const headers = {
    'Authorization': `Bearer ${apiKey}`,
    'Content-Type': 'application/json',
    'HTTP-Referer': window.location.origin,
  };

  // Retry up to 2 times on network errors (ERR_QUIC_PROTOCOL_ERROR, etc.)
  // AbortError (user stop) is not retried.
  const MAX_RETRIES = 2;
  let lastError: unknown;
  for (let attempt = 1; attempt <= MAX_RETRIES; attempt++) {
    try {
      if (signal?.aborted) throw new DOMException('Aborted', 'AbortError');
      const resp = await llmFetchStream(endpoint, headers, body, signal);
      const noop = () => {};
      return await readStream(resp, onStream ?? noop);
    } catch (err: unknown) {
      if (err instanceof DOMException && err.name === 'AbortError') throw err;
      lastError = err;
      if (attempt < MAX_RETRIES) {
        console.warn(`[SimpleGeneration] Network error on attempt ${attempt}, retrying...`, err);
        // Brief pause before retry — let QUIC connection reset
        await new Promise(r => setTimeout(r, 1500 * attempt));
      }
    }
  }
  throw lastError;
}

// ─── Vision Analysis Helper ──────────────────────────────────────────────────

/**
 * Sends an image to the spec-slot model and returns a structured JSON
 * description of the design (color scheme, navigation, components, etc.).
 * Returns '' on any error so callers can degrade gracefully.
 */
async function analyzeImageWithVision(
  imageDataUri: string,
  mimeType: string,
  fallbackApiKey: string,
  onLog?: (msg: string) => void,
  signal?: AbortSignal,
): Promise<string> {
  onLog?.('[Intake] Analyzing image with Vision...');

  const modelId  = ConfigService.resolveModel('spec');
  const apiKey   = ConfigService.getKeyForAgent('spec') || fallbackApiKey;
  const provider = ConfigService.getAgentConfig('agent_spec').provider || 'openrouter';
  const endpoint = Orchestrator.getEndpoint(provider);

  const body = JSON.stringify({
    model: modelId,
    messages: [{
      role: 'user',
      content: [
        { type: 'image_url', image_url: { url: imageDataUri } },
        {
          type: 'text',
          text: `Analyze this screenshot/design reference and extract:
1. App type (what kind of application is this?)
2. Color scheme (primary colors, background color, accent color — give hex codes)
3. Navigation pattern (top bar, bottom tabs, sidebar, none)
4. Key UI components visible (cards, lists, charts, forms, etc.)
5. Layout density (compact/comfortable/spacious)
6. Overall visual style (minimal, colorful, dark, light, etc.)

Respond in JSON format:
{
  "appType": "...",
  "colorScheme": { "background": "#...", "primary": "#...", "accent": "#..." },
  "navigation": "top-nav|bottom-tabs|sidebar|none",
  "components": ["card", "list", ...],
  "density": "compact|comfortable|spacious",
  "style": "...",
  "summary": "One sentence describing this design"
}`,
        },
      ],
    }],
    stream: false,
    temperature: 0.2,
    max_tokens: 1000,
  });

  const headers = {
    'Authorization': `Bearer ${apiKey}`,
    'Content-Type':  'application/json',
    'HTTP-Referer':  window.location.origin,
  };

  try {
    if (signal?.aborted) throw new DOMException('Aborted', 'AbortError');
    const resp = await llmFetch(endpoint, headers, body);
    const data = await resp.json() as { choices?: Array<{ message?: { content?: string } }> };
    const text = (data.choices?.[0]?.message?.content ?? '').trim();
    onLog?.(`[Intake] Vision analysis complete: ${text.slice(0, 120)}`);
    return text;
  } catch (e) {
    if (e instanceof DOMException && e.name === 'AbortError') throw e;
    onLog?.(`[Intake] Vision API error: ${e}`);
    return '';
  }
}

// ─── File Validator ─────────────────────────────────────────────────────────

/**
 * Returns false if the file content is too short, missing code keywords,
 * or has severely mismatched braces (strong sign the LLM truncated output).
 */
function validateFile(path: string, content: string): boolean {
  if (!content || content.trim().length < 20) return false;
  if ((path.endsWith('.tsx') || path.endsWith('.ts')) &&
      !/(?:export|import|function|const)\s/.test(content)) return false;
  const opens  = (content.match(/\{/g) || []).length;
  const closes = (content.match(/\}/g) || []).length;
  if (opens > 0 && Math.abs(opens - closes) > 5) return false;
  return true;
}

// ─── Error File Extractor ────────────────────────────────────────────────────

/**
 * Extracts the relative file path from a Vite error message.
 * Handles patterns like "src/pages/X.tsx", "/src/X.tsx", URL paths.
 */
function extractFileFromError(msg: string): string | null {
  const match = msg.match(/(?:src\/)([\w/.]+\.tsx?)/);
  return match ? match[1] : null;
}

// ─── shadcn Enforcer ────────────────────────────────────────────────────────

/**
 * Validates and auto-fixes LLM output to enforce shadcn/ui components and
 * design tokens. Mutates llmFiles in place.
 */
function enforceShadcn(llmFiles: Record<string, string>, onLog: (msg: string) => void): void {
  const allCode = Object.values(llmFiles).join('\n');
  const hasShadcn    = allCode.includes('@/components/ui/');
  const hasRawButtons = /<button[\s>]/.test(allCode);
  const hasRawInputs  = /<input[\s/]/.test(allCode);
  const hasRawColors  = /bg-(?:blue|green|red|indigo|purple|pink|yellow|orange)-[0-9]/.test(allCode);

  if (!hasShadcn || hasRawButtons || hasRawInputs || hasRawColors) {
    onLog(`[SimpleGeneration] ⚠ shadcn check: imports=${hasShadcn} rawButtons=${hasRawButtons} rawInputs=${hasRawInputs} rawColors=${hasRawColors}`);

    for (const [filePath, content] of Object.entries(llmFiles)) {
      let fixed = content;

      if (/<button[\s>]/.test(fixed)) {
        if (!fixed.includes('@/components/ui/button')) {
          fixed = `import { Button } from "@/components/ui/button";\n` + fixed;
        }
        // Simple tag-name swap — handles multi-line JSX attrs correctly
        fixed = fixed.replace(/<button(\s)/g, '<Button$1');
        fixed = fixed.replace(/<button>/g, '<Button>');
        fixed = fixed.replace(/<\/button>/g, '</Button>');
      }

      if (/<input[\s/]/.test(fixed)) {
        if (!fixed.includes('@/components/ui/input')) {
          fixed = `import { Input } from "@/components/ui/input";\n` + fixed;
        }
        fixed = fixed.replace(/<input(\s)/g, '<Input$1');
        fixed = fixed.replace(/<input\/>/g, '<Input />');
      }

      fixed = fixed.replace(/bg-gray-900/g,        'bg-background');
      fixed = fixed.replace(/bg-gray-800/g,         'bg-card');
      fixed = fixed.replace(/bg-gray-700/g,         'bg-muted');
      fixed = fixed.replace(/text-gray-100/g,       'text-foreground');
      fixed = fixed.replace(/text-gray-300/g,       'text-foreground');
      fixed = fixed.replace(/text-gray-400/g,       'text-muted-foreground');
      fixed = fixed.replace(/text-gray-500/g,       'text-muted-foreground');
      fixed = fixed.replace(/text-white/g,          'text-foreground');
      fixed = fixed.replace(/border-gray-[0-9]+/g,  'border-border');

      if (fixed !== content) {
        llmFiles[filePath] = fixed;
        onLog(`[SimpleGeneration] Auto-fixed: ${filePath}`);
      }
    }
  }
}

// ─── Blueprint formatter ────────────────────────────────────────────────────

function formatBlueprint(plan: any): string {
  const lines: string[] = [];
  const b = plan.blueprint;

  lines.push(`## ${plan.appName}`);
  lines.push(`_${plan.description}_`);
  lines.push('');

  if (plan.targetUser) {
    lines.push(`**Target user:** ${plan.targetUser}`);
    lines.push('');
  }

  if (plan.productStrategy) {
    lines.push('### Product Strategy');
    lines.push(`- **Core action:** ${plan.productStrategy.coreAction}`);
    lines.push(`- **Retention:** ${plan.productStrategy.retentionLoop}`);
    if (plan.productStrategy.paywall?.needed) {
      lines.push(`- **Monetization:** ${plan.productStrategy.paywall.trigger}`);
    }
    lines.push('');
  }

  if (plan.pages?.length) {
    lines.push('### Screens');
    plan.pages.forEach((p: any, i: number) => {
      const guard = p.guard ? ` _(${p.guard})_` : '';
      lines.push(`${i + 1}. **${p.name}** — ${p.purpose}${guard}`);
    });
    lines.push('');
  }

  if (b?.userJourney) {
    lines.push('### User Journey');
    lines.push(b.userJourney);
    lines.push('');
  }

  if (b?.stateMachine) {
    lines.push('### State Machine');
    lines.push(b.stateMachine);
    lines.push('');
  }

  if (b?.logicBlackBox) {
    lines.push('### Logic (Black Box)');
    lines.push(b.logicBlackBox);
    lines.push('');
  }

  if (b?.uiSpec) {
    lines.push('### UI Components');
    lines.push(b.uiSpec);
    lines.push('');
  }

  return lines.join('\n');
}

// ─── Main Service ───────────────────────────────────────────────────────────

export class SimpleGeneration {
  /**
   * Lightweight pre-generation step: ask the LLM whether the user's request
   * is specific enough to build directly, or whether 1-2 clarifying questions
   * would help. Returns null if the intent is already clear or if the call
   * fails (network error, parse error) — callers should treat null as "skip".
   */
  static async clarify(config: {
    intent:  string;
    apiKey:  string;
    signal?: AbortSignal;
  }): Promise<{ questions: string[] } | null> {
    const CLARIFIER_PROMPT = `You are a product advisor. The user wants to build an app.

Analyze their request. If it's clear and specific enough to build — respond with:
{"clear": true}

If it's vague or would benefit from clarification — respond with:
{"clear": false, "questions": ["question1", "question2"]}

RULES:
- Maximum 2 questions. Keep them short and specific.
- Ask about WHAT the app does, not HOW to build it.
- If the user already described features, pages, or specific functionality — it's clear.
- If it's just a category ("fitness app", "todo app") — ask what features.
- Questions should offer concrete options, not open-ended.
- Respond ONLY with JSON. No markdown, no explanation.

EXAMPLES:
User: "fitness app" → {"clear": false, "questions": ["What should it track — workouts, meals, weight, or all three?", "Should it have a social feature like sharing progress?"]}
User: "task manager with projects, tags, and due dates" → {"clear": true}
User: "restaurant app" → {"clear": false, "questions": ["Is this for customers (menu, ordering, reviews) or for staff (table management, orders)?", "Should it support online ordering and delivery?"]}
User: "pregnancy tracker with weekly updates and symptom log" → {"clear": true}`;

    let raw: string;
    try {
      raw = await callLLM(
        CLARIFIER_PROMPT,
        config.intent,
        'primary',
        config.apiKey,
        undefined,
        config.signal,
      );
    } catch (err) {
      // Re-throw user aborts so the caller's abort handling works correctly.
      if (err instanceof DOMException && err.name === 'AbortError') throw err;
      return null; // network / timeout error → skip clarification silently
    }
    try {
      const cleaned = raw.trim().replace(/^```json?\s*\n?/, '').replace(/\n?```\s*$/, '');
      const parsed: unknown = JSON.parse(cleaned);
      if (typeof parsed !== 'object' || parsed === null) return null;
      const p = parsed as Record<string, unknown>;
      if (p['clear'] === true) return null;
      const qs = Array.isArray(p['questions'])
        ? (p['questions'] as unknown[]).filter((q): q is string => typeof q === 'string')
        : [];
      return qs.length > 0 ? { questions: qs } : null;
    } catch {
      return null; // JSON parse failure → skip clarification
    }
  }

  /**
   * Calls a vision-capable model to describe uploaded images.
   * Returns a combined description, or '' on failure.
   */
  static async describeImages(
    images: Array<{ data: string; mimeType: string; name: string }>,
    apiKey: string,
    modelId: string,
    signal?: AbortSignal,
  ): Promise<string> {
    if (images.length === 0) return '';

    const agentConfig = ConfigService.getAgentConfig('agent_primary');
    const provider    = agentConfig.provider || 'openrouter';
    const endpoint    = Orchestrator.getEndpoint(provider);
    const effectiveKey = ConfigService.getKeyForAgent('primary') || apiKey;

    const imageContent = images.map(img => ({
      type: 'image_url' as const,
      image_url: { url: img.data },
    }));

    const messages = [
      {
        role: 'user' as const,
        content: [
          ...imageContent,
          {
            type: 'text' as const,
            text: 'Describe this UI screenshot in detail: layout, colors, components, navigation, spacing, typography. Be specific about what each section contains and how it looks visually. This description will be used to recreate a similar UI.',
          },
        ],
      },
    ];

    const body = JSON.stringify({
      model:       modelId,
      messages,
      stream:      false,
      temperature: 0.2,
      max_tokens:  1000,
    });

    const headers = {
      'Authorization': `Bearer ${effectiveKey}`,
      'Content-Type':  'application/json',
      'HTTP-Referer':  window.location.origin,
    };

    try {
      if (signal?.aborted) throw new DOMException('Aborted', 'AbortError');
      const resp = await llmFetch(endpoint, headers, body);
      const data = await resp.json() as { choices?: Array<{ message?: { content?: string } }> };
      return (data.choices?.[0]?.message?.content ?? '').trim();
    } catch (e) {
      if (e instanceof DOMException && e.name === 'AbortError') throw e;
      console.warn('[SimpleGeneration] Vision API error:', e);
      return '';
    }
  }

  static async run(config: PipelineRunConfig): Promise<GenerationResult> {
    const startMs = Date.now();
    config.onLog('[SimpleGeneration] starting');

    // ── Health check — bridge must be available ───────────────────────────
    try {
      const health = await fetch('/__health_preview');
      if (!health.ok) throw new Error('Preview bridge returned non-OK status');
    } catch (e) {
      config.onLog(`[SimpleGeneration] ❌ Preview bridge unavailable: ${e}`);
      throw new Error('Preview app is not running. Start it with npm run dev:all');
    }

    // ── Detect mode: NEW (no project) or EDIT (project exists) ───────────
    let existingFiles: Record<string, string> = {};
    try {
      const resp = await fetch('/__read_all_preview');
      if (resp.ok) {
        const data = await resp.json() as { files?: Record<string, string> };
        existingFiles = data.files ?? {};
        // Exclude placeholder App.tsx — not real user content
        if (existingFiles['App.tsx']?.includes('Waiting for generation')) {
          delete existingFiles['App.tsx'];
        }
        // Exclude index.css — it is the theme file, not user code
        delete existingFiles['index.css'];
      }
    } catch (e) {
      config.onLog(`[SimpleGeneration] Could not read existing files: ${e}`);
    }

    // EDIT mode requires BOTH: files on disk AND files in useStudio state.
    // If useStudio has no files (singlePageSafeMode=true), user started a new project
    // → force NEW mode even if old files remain on disk (race with clearPreview).
    const studioHasFiles = !config.singlePageSafeMode;
    const isEditMode = studioHasFiles && Object.keys(existingFiles).length > 0;
    config.onLog(`[SimpleGeneration] Mode: ${isEditMode ? 'EDIT' : 'NEW'} (${Object.keys(existingFiles).length} disk files, studioHasFiles=${studioHasFiles})`);

    // ── Process attachments → build visual / doc context ─────────────────
    let attachmentContext = '';
    if (config.attachments?.length) {
      for (const att of config.attachments) {
        if (att.type === 'image' && att.data) {
          const analysis = await analyzeImageWithVision(
            att.data, att.mimeType, config.apiKey, config.onLog, config.signal,
          );
          if (analysis) {
            attachmentContext += `\n\nDESIGN REFERENCE (${att.name}):\n${analysis}`;
          }
        } else if (att.type === 'pdf' && att.textContent) {
          attachmentContext += `\n\nDOCUMENT CONTEXT (${att.name}):\n${att.textContent.slice(0, 3000)}`;
        } else if ((att.type === 'text' || att.type === 'code') && att.data && !att.data.startsWith('data:')) {
          attachmentContext += `\n\nDOCUMENT CONTEXT (${att.name}):\n${att.data.slice(0, 2000)}`;
        }
      }
      if (attachmentContext) {
        config.onLog(`[SimpleGeneration] Attachment context: ${attachmentContext.length} chars`);
      }
    }

    // ── EDIT MODE ─────────────────────────────────────────────────────────
    if (isEditMode) {
      config.onPhase({ phase: 'code', progress: 30 });
      config.onLog('[SimpleGeneration] EDIT mode — skipping Architect');

      const currentCode = Object.entries(existingFiles)
        .map(([p, content]) => `<!--EXISTING_FILE:${p}-->\n${content}`)
        .join('\n\n');

      const editSystemPrompt = `You are editing an existing React application.
The user wants a SPECIFIC change. Apply ONLY what they asked for.

CURRENT APPLICATION:
${currentCode}

RULES:
1. Output ONLY files that need modification using <!--FILE:path--> format.
2. DO NOT include files that don't need changes.
3. PRESERVE all existing functionality, state, imports, and types.
4. Use the same design tokens and shadcn components as the existing code.
5. DO NOT change navigation structure unless explicitly asked.
6. DO NOT rename or restructure files unless explicitly asked.
7. If adding a new feature: add it to the appropriate existing page,
   or create a new page AND update App.tsx routing.
${SHADCN_CHEATSHEET}`;

      const editRaw = await callLLM(
        editSystemPrompt,
        config.intent + attachmentContext,
        'build',
        config.apiKey,
        config.onStream,
        config.signal,
      );
      config.onLog(`[SimpleGeneration] EDIT Coder response: ${editRaw.length} chars`);

      const editLlmFiles = parseFileMarkers(editRaw);
      config.onLog(`[SimpleGeneration] EDIT parsed: ${Object.keys(editLlmFiles).length} files`);

      enforceShadcn(editLlmFiles, config.onLog);

      // ── Level 1: Validate — drop files that look truncated / empty ──────
      for (const [filePath, content] of Object.entries(editLlmFiles)) {
        if (!validateFile(filePath, content)) {
          config.onLog(`[SimpleGeneration] ⚠ EDIT: Skipped invalid: ${filePath}`);
          delete editLlmFiles[filePath];
        }
      }

      // Build finalFiles with src/ keys for code editor display
      const editFinalFiles: Record<string, string> = {};
      for (const [p, content] of Object.entries(editLlmFiles)) {
        editFinalFiles[toSrcKey(p)] = content;
      }

      // FileOperations for useStudio (upsert only — existing files untouched)
      const editOps: FileOperation[] = Object.entries(editFinalFiles)
        .map(([name, content]) => ({ op: 'upsert' as const, name, content }));
      config.onFiles(editOps);

      // Write ONLY changed files — no clearPreview()
      config.onPhase({ phase: 'verify', progress: 85 });
      for (const [p, content] of Object.entries(editLlmFiles)) {
        await writePreviewFile(p, content);
      }
      config.onLog(`[SimpleGeneration] EDIT: wrote ${Object.keys(editLlmFiles).length} files (preserved ${Object.keys(existingFiles).length})`);

      // Signal preview iframe to reload after Vite HMR recompiles
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('force-preview-reload'));
      }, 2000);

      config.onPhase({ phase: 'idle', progress: 100 });
      const editDurationMs = Date.now() - startMs;
      config.onLog(`[SimpleGeneration] done: ${editOps.length} files, ${editDurationMs}ms`);

      const editNow = new Date().toISOString();
      const editBlueprints: FileBlueprint[] = Object.entries(editFinalFiles).map(
        ([p, c]) => makeBlueprint(p, c),
      );
      const editGraph: ProjectGraph = {
        version: 1 as const,
        id: crypto.randomUUID(),
        projectId: config.projectId ?? '',
        revisionId: config.revisionId ?? '',
        manifest: emptyManifest(config.intent),
        files: editBlueprints,
        routes: [],
        features: [],
        externalDependencies: [],
        entryFileId: djb2('src/App.tsx'),
        createdAt: editNow,
        updatedAt: editNow,
      };

      const editResult: GenerationResult = {
        id: crypto.randomUUID(),
        status: 'complete',
        graph: editGraph,
        operations: editOps,
        message: cleanCoderMessage(editRaw, 'Updated files and refreshing preview.'),
        phase: 'idle' as AgentPhase,
        usedModel: ConfigService.resolveModel('build') || config.modelId,
        selfCorrected: false,
        iterations: 1,
        durationMs: editDurationMs,
        createdAt: editNow,
        changePackage: emptyChangePackage(editGraph, editOps),
        dependencies: [],
        previewMeta: { entryFile: 'src/App.tsx', framework: 'react', isMultiPage: false },
        warnings: [],
        repairHints: [],
      };
      editResult.qualitySummary = GenerationQualityService.evaluate(editResult);
      config.onLog(`[SimpleGeneration] quality: ${editResult.qualitySummary.severity} — ${editResult.qualitySummary.summary}`);
      return editResult;
    }

    // ── NEW MODE ──────────────────────────────────────────────────────────
    const mode = config.generationMode ?? 'app';
    config.onLog(`[SimpleGeneration] Generation mode: ${mode}`);

    const coderTokens = mode === 'landing' ? 8000 : mode === 'superapp' ? 32000 : 16000;

    let plan: Record<string, unknown>;

    // ── Step 1: Architect (primary slot) — JSON plan — SKIPPED if prebuiltPlan ──
    if (config.prebuiltPlan) {
      plan = config.prebuiltPlan as unknown as Record<string, unknown>;
      config.onLog('[SimpleGeneration] Architect skipped — plan from WeeklyFeed (internet-sourced)');
      config.onPhase({ phase: 'code', progress: 30 });
    } else {
      config.onPhase({ phase: 'think', progress: 10 });
      config.onLog('[SimpleGeneration] Step 1: Architect planning...');

      const architectPrompt = mode === 'landing' ? ARCHITECT_PROMPT_LANDING
                            : mode === 'superapp' ? ARCHITECT_PROMPT_SUPERAPP
                            : ARCHITECT_PROMPT;
      const architectTokens = mode === 'landing' ? 2000 : mode === 'superapp' ? 6000 : 6000;

      const planRaw = await callLLM(
        architectPrompt,
        config.intent + attachmentContext,
        'primary',
        config.apiKey,
        undefined,
        config.signal,
        architectTokens,
      );

      try {
        // Log thinking block if present
        const thinkMatch = planRaw.match(/<thinking>([\s\S]*?)<\/thinking>/);
        if (thinkMatch) {
          config.onLog(`[SimpleGeneration] Architect thinking: ${thinkMatch[1].slice(0, 300)}...`);
        }
        // Strip <thinking>...</thinking> block if present, then strip markdown fences
        let jsonPart = planRaw;
        const thinkEnd = planRaw.lastIndexOf('</thinking>');
        if (thinkEnd >= 0) {
          jsonPart = planRaw.slice(thinkEnd + '</thinking>'.length);
        }
        const cleaned = jsonPart.trim().replace(/^```json?\s*\n?/, '').replace(/\n?```\s*$/, '');
        plan = JSON.parse(cleaned);
      } catch {
        plan = {
          appName: 'App',
          description: config.intent,
          theme: 'dark-slate',
          targetUser: 'General user',
          layout: { type: 'single', navigation: 'none' },
          pages: [{ path: '/', name: 'App', file: 'App.tsx', purpose: config.intent, isMainScreen: true, keyElements: [] }],
          dataModel: { entities: [], sharedState: '' },
          shadcnComponents: ['Button', 'Card', 'Input'],
          icons: ['Home'],
        };
        config.onLog('[SimpleGeneration] Plan parse failed, using fallback plan');
      }
    }
    config.onLog(`[SimpleGeneration] Plan: ${JSON.stringify(plan).slice(0, 200)}`);
    console.log('[SimpleGeneration] Architect plan:', plan);

    // Feed plan steps to the UI
    const planSteps = (plan.pages as Array<{ name: string }> | undefined)
      ?.map((p) => p.name) ?? ['App'];
    config.onPlan(planSteps, (plan.appName as string) ?? '');

    // ── Step 1.5: Tech Lead — plan → technical blueprint ───────────────
    config.onLog('[SimpleGeneration] Step 1.5: Tech Lead translating plan...');

    let technicalBlueprint: Record<string, unknown> | null = null;
    try {
      const techLeadRaw = await callLLM(
        TECH_LEAD_PROMPT,
        'PRODUCT PLAN:\n' + JSON.stringify(plan, null, 2),
        'primary',
        config.apiKey,
        undefined,
        config.signal,
        3500,
      );

      const tbCleaned = techLeadRaw
        .replace(/^```json?\n?/, '')
        .replace(/\n?```$/, '')
        .trim();

      const tbParsed = JSON.parse(tbCleaned);
      technicalBlueprint = tbParsed?.technicalBlueprint ?? null;

      config.onLog('[SimpleGeneration] Technical blueprint ready');
    } catch (error) {
      config.onLog('[SimpleGeneration] Tech Lead parse failed — using plan directly');
      console.warn('[SimpleGeneration] Tech Lead parse failed', error);
    }

    // ── Blueprint confirmation flow ──────────────────────────────────────
    const blueprintText = formatBlueprint(plan);

    config.onPlanReady?.({
      plan,
      blueprintText,
      technicalBlueprint,
      appName: (plan.appName as string) ?? '',
      theme:   (plan.theme as string) ?? 'dark-slate',
      pages:   planSteps,
    });

    if (config.waitForConfirmation) {
      const confirmed = await config.waitForConfirmation(plan);
      if (!confirmed) {
        config.onLog('[SimpleGeneration] User cancelled — generation stopped');
        config.onPhase({ phase: 'idle', progress: 0 });
        const cancelNow = new Date().toISOString();
        const emptyGraph: ProjectGraph = {
          version: 1 as const,
          id: crypto.randomUUID(),
          projectId: config.projectId ?? '',
          revisionId: config.revisionId ?? crypto.randomUUID(),
          manifest: emptyManifest(config.intent),
          files: [],
          routes: [],
          features: [],
          externalDependencies: [],
          entryFileId: '',
          createdAt: cancelNow,
          updatedAt: cancelNow,
        };
        return {
          id:            crypto.randomUUID(),
          status:        'cancelled' as const,
          graph:         emptyGraph,
          operations:    [],
          message:       'Generation cancelled by user',
          phase:         'idle' as AgentPhase,
          usedModel:     config.modelId,
          selfCorrected: false,
          iterations:    0,
          durationMs:    Date.now() - startMs,
          planTheme:     (plan.theme as string) ?? 'dark-slate',
          createdAt:     new Date().toISOString(),
          changePackage: emptyChangePackage(emptyGraph, []),
          dependencies:  [],
          previewMeta:   { entryFile: 'src/App.tsx', framework: 'react', isMultiPage: false },
          warnings:      [],
          repairHints:   [],
        };
      }
    }

    // ── Apply theme from Architect plan ───────────────────────────────────
    const themeName = (plan.theme as string) || 'dark-slate';
    const validThemes = ['dark-slate', 'trust', 'warm', 'neon', 'bloom'];
    const selectedTheme = validThemes.includes(themeName) ? themeName : 'dark-slate';

    // Build themed index.css now but write it AFTER clearPreview + LLM files
    // so it always wins over any index.css the LLM may have generated.
    let themedIndexCss: string | null = null;
    try {
      const themeResp = await fetch(`/__read_preview?path=themes/${selectedTheme}.css`);
      if (themeResp.ok) {
        const themeData = await themeResp.json();
        if (themeData.content) {
          themedIndexCss = [
            '@tailwind base;',
            '@tailwind components;',
            '@tailwind utilities;',
            '',
            '@layer base {',
            themeData.content,
            '}',
            '',
            '@layer base {',
            '  * { @apply border-border; }',
            '  body { @apply bg-background text-foreground; }',
            '}',
            '',
            'body {',
            "  font-family: 'Inter', system-ui, -apple-system, sans-serif;",
            '  -webkit-font-smoothing: antialiased;',
            '}',
          ].join('\n');
          config.onLog(`[SimpleGeneration] Theme ready: ${selectedTheme}`);
        }
      } else {
        config.onLog(`[SimpleGeneration] Theme fetch failed (${themeResp.status}), keeping default`);
      }
    } catch (e) {
      config.onLog(`[SimpleGeneration] Theme fetch error: ${String(e)}`);
    }

    // ── Step 2: Coder (build slot) — generate code ────────────────────────
    config.onPhase({ phase: 'code', progress: 40 });
    config.onLog('[SimpleGeneration] Step 2: Coder generating...');

    const coderSystemPrompt = SYSTEM_PROMPT
      + CSS_RECIPES
      + SHADCN_CHEATSHEET
      + '\n\nPRODUCT PLAN (SOURCE OF TRUTH):\n'
      + JSON.stringify(plan, null, 2)
      + (technicalBlueprint
          ? '\n\nTECHNICAL BLUEPRINT (IMPLEMENTATION GUIDE):\n'
            + JSON.stringify(technicalBlueprint, null, 2)
          : '');

    const raw = await callLLM(
      coderSystemPrompt,
      config.intent,
      'build',
      config.apiKey,
      config.onStream,
      config.signal,
      coderTokens,
    );
    config.onLog(`[SimpleGeneration] Coder response: ${raw.length} chars`);

    // 5. Parse files from LLM output
    // Debug: log raw response boundaries to diagnose parse failures
    console.log('[SimpleGeneration] RAW first 500:', raw.slice(0, 500));
    console.log('[SimpleGeneration] RAW last 200:', raw.slice(-200));

    const llmFiles = parseFileMarkers(raw);

    console.log('[SimpleGeneration] FILE markers found:', Object.keys(llmFiles));
    for (const [p, c] of Object.entries(llmFiles)) {
      console.log(`[SimpleGeneration] FILE ${p}: ${c.length} chars, first 80: ${c.slice(0, 80)}`);
    }
    config.onLog(`[SimpleGeneration] parsed: ${Object.keys(llmFiles).length} files`);

    // ── Guard: App.tsx is mandatory — build minimal fallback if LLM skipped it ──
    const hasAppTsx = '/App.tsx' in llmFiles || '/src/App.tsx' in llmFiles;
    if (!hasAppTsx) {
      config.onLog('[SimpleGeneration] ⚠ App.tsx missing from LLM output — generating fallback from plan');
      const planPages = (plan.pages as Array<{ path: string; name: string; file: string }> | undefined) ?? [];
      const routePages = planPages.filter(p => p.file !== 'App.tsx' && p.name !== 'App');

      const importLines = routePages.map(p => {
        const rel = p.file.replace(/^(src\/)?/, './').replace(/\.tsx$/, '');
        return `import ${p.name} from '${rel}';`;
      });
      const routeLines = routePages.map(p =>
        `        <Route path="${p.path}" element={<${p.name} />} />`
      );

      llmFiles['/App.tsx'] = [
        routePages.length > 0 ? `import { BrowserRouter, Routes, Route } from 'react-router-dom';` : '',
        ...importLines,
        '',
        'export default function App() {',
        '  return (',
        routePages.length > 0
          ? `    <BrowserRouter>\n      <Routes>\n${routeLines.join('\n')}\n      </Routes>\n    </BrowserRouter>`
          : '    <div className="min-h-screen bg-background text-foreground" />',
        '  );',
        '}',
      ].filter(l => l !== '').join('\n') + '\n';

      config.onLog(`[SimpleGeneration] Fallback App.tsx generated (${routePages.length} routes)`);
    }

    // ── Enforce shadcn: validate + auto-fix ─────────────────────
    enforceShadcn(llmFiles, config.onLog);

    // ── Level 1: Validate — drop files that look truncated / empty ────────
    for (const [filePath, content] of Object.entries(llmFiles)) {
      if (!validateFile(filePath, content)) {
        config.onLog(`[SimpleGeneration] ⚠ Skipped invalid: ${filePath}`);
        delete llmFiles[filePath];
      }
    }
    // If App.tsx was dropped by validation, regenerate the minimal fallback
    if (!('/App.tsx' in llmFiles) && !('/src/App.tsx' in llmFiles)) {
      const planPages = (plan.pages as Array<{ path: string; name: string; file: string }> | undefined) ?? [];
      const routePages = planPages.filter(p => p.file !== 'App.tsx' && p.name !== 'App');
      const importLines = routePages.map(p => {
        const rel = p.file.replace(/^(src\/)?/, './').replace(/\.tsx$/, '');
        return `import ${p.name} from '${rel}';`;
      });
      const routeLines = routePages.map(p =>
        `        <Route path="${p.path}" element={<${p.name} />} />`
      );
      llmFiles['/App.tsx'] = [
        routePages.length > 0 ? `import { BrowserRouter, Routes, Route } from 'react-router-dom';` : '',
        ...importLines,
        '',
        'export default function App() {',
        '  return (',
        routePages.length > 0
          ? `    <BrowserRouter>\n      <Routes>\n${routeLines.join('\n')}\n      </Routes>\n    </BrowserRouter>`
          : '    <div className="min-h-screen bg-background text-foreground p-8"><p className="text-foreground">App generated. Start chatting to customise.</p></div>',
        '  );',
        '}',
      ].filter(l => l !== '').join('\n') + '\n';
      config.onLog('[SimpleGeneration] App.tsx fallback regenerated after validation');
    }

    // 6. Build final file map with src/ keys for code editor display
    const finalFiles: Record<string, string> = {};
    for (const [path, content] of Object.entries(llmFiles)) {
      finalFiles[toSrcKey(path)] = content;
    }
    config.onLog(`[SimpleGeneration] final files: ${Object.keys(finalFiles).join(', ')}`);

    // 7. Create FileOperations for useStudio editor display
    const ops: FileOperation[] = Object.entries(finalFiles)
      .map(([name, content]) => ({ op: 'upsert' as const, name, content }));
    config.onFiles(ops);

    // 8. Write files to preview-app/src/ — Vite HMR picks them up
    config.onPhase({ phase: 'verify', progress: 85 });

    // Clear previous generated files (keeps main.tsx, index.css, components/, lib/, themes/)
    await clearPreview();

    // Write each LLM-generated file — skip index.css, theme will be applied last
    let writtenCount = 0;
    for (const [path, content] of Object.entries(llmFiles)) {
      const normalised = path.startsWith('/') ? path.slice(1) : path;
      const withoutSrc = normalised.startsWith('src/') ? normalised.slice(4) : normalised;
      if (withoutSrc === 'index.css') {
        config.onLog(`[SimpleGeneration] Skipped LLM index.css (theme will overwrite)`);
        continue;
      }
      await writePreviewFile(path, content);
      writtenCount++;
    }

    // Apply theme last — guaranteed to win over any LLM-generated index.css
    if (themedIndexCss) {
      await writePreviewFile('/index.css', themedIndexCss);
      config.onLog(`[SimpleGeneration] Theme applied: ${selectedTheme}`);
    } else {
      config.onLog(`[SimpleGeneration] No theme CSS — default index.css preserved`);
    }

    config.onLog(`[SimpleGeneration] wrote ${writtenCount} LLM files + theme to preview-app`);

    // Signal preview iframe to reload after Vite HMR picks up the new files.
    // 2 s gives Vite enough time to detect + recompile before the iframe refreshes.
    setTimeout(() => {
      window.dispatchEvent(new CustomEvent('force-preview-reload'));
    }, 2000);

    config.onPhase({ phase: 'idle', progress: 100 });
    const durationMs = Date.now() - startMs;
    config.onLog(`[SimpleGeneration] done: ${ops.length} files, ${durationMs}ms`);

    // 9. Build ProjectGraph (for code editor compatibility)
    const now = new Date().toISOString();
    const blueprints: FileBlueprint[] = Object.entries(finalFiles).map(
      ([p, c]) => makeBlueprint(p, c),
    );
    const graph: ProjectGraph = {
      version: 1 as const,
      id: crypto.randomUUID(),
      projectId: config.projectId ?? '',
      revisionId: config.revisionId ?? '',
      manifest: emptyManifest(config.intent),
      files: blueprints,
      routes: [],
      features: [],
      externalDependencies: [],
      entryFileId: djb2('src/App.tsx'),
      createdAt: now,
      updatedAt: now,
    };

    const changePackage = emptyChangePackage(graph, ops);

    // 10. Return result — preview is handled by Vite HMR on port 3100
    const result: GenerationResult = {
      id: crypto.randomUUID(),
      status: 'complete',
      graph,
      operations: ops,
      message: cleanCoderMessage(raw),
      phase: 'idle' as AgentPhase,
      usedModel: ConfigService.resolveModel('build') || config.modelId,
      selfCorrected: false,
      iterations: 1,
      durationMs,
      planTheme: selectedTheme,
      createdAt: now,
      changePackage,
      dependencies: [],
      previewMeta: { entryFile: 'src/App.tsx', framework: 'react', isMultiPage: false },
      warnings: [],
      repairHints: [],
    };
    result.qualitySummary = GenerationQualityService.evaluate(result);
    config.onLog(`[SimpleGeneration] quality: ${result.qualitySummary.severity} — ${result.qualitySummary.summary}`);
    return result;
  }

  // ── Level 2: Auto-fixer — called on iframe-error ─────────────────────────
  /**
   * Reads the broken file from preview-app, asks the 'fix' agent to repair it,
   * and writes the corrected version back. Returns true if a fix was written.
   */
  static async autoFix(config: {
    errorMsg: string;
    apiKey:   string;
    onLog?:   (msg: string) => void;
    signal?:  AbortSignal;
  }): Promise<boolean> {
    const log = config.onLog ?? (() => {});

    // ── Missing import fast-path ──────────────────────────────────────────────
    // Pattern: Failed to resolve import "./pages/Profile" from "src/App.tsx"
    const missingImportMatch = config.errorMsg.match(
      /Failed to resolve import ["']([^"']+)["'] from ["']([^"']+)["']/,
    );
    if (missingImportMatch) {
      const [, missingModule, sourceFile] = missingImportMatch;
      // Build the file path: strip leading ./ and add .tsx extension
      const missingPath = missingModule.replace(/^\.\//, '') + '.tsx';
      log(`[AutoFix] Missing file detected: ${missingPath} (imported from ${sourceFile})`);

      try {
        // Read the source file for context
        const cleanSource = sourceFile.replace(/^src\//, '');
        const sourceResp = await fetch(`/__read_preview?path=${encodeURIComponent(cleanSource)}`);
        const sourceData = await sourceResp.json() as { content?: string; ok?: boolean };
        const sourceCode = sourceData.content ?? '';

        const fixPrompt = `A React/TypeScript file is missing: ${missingPath}

It is imported in ${sourceFile}:
${sourceCode.slice(0, 2000)}

Generate the missing file ${missingPath}.
Look at how it is used in the imports and JSX/routes to understand what it should contain.
Create a complete, working React component that fits the app style and design tokens.
Use the same shadcn components and design patterns visible in the source file.

Output ONLY the file using <!--FILE:${missingPath}--> marker. No explanation.`;

        log(`[AutoFix] Generating missing file: ${missingPath}...`);
        const fixed = await callLLM(fixPrompt, '', 'fix', config.apiKey, undefined, config.signal);
        const fixedFiles = parseFileMarkers(fixed);

        if (Object.keys(fixedFiles).length === 0) {
          log(`[AutoFix] No content generated for ${missingPath}`);
          return false;
        }

        for (const [path, content] of Object.entries(fixedFiles)) {
          if (!validateFile(path, content)) continue;
          await writePreviewFile(path, content);
          log(`[AutoFix] ✓ Generated missing file: ${path}`);
        }
        return true;
      } catch (e: unknown) {
        if (e instanceof DOMException && e.name === 'AbortError') throw e;
        log(`[AutoFix] Missing-import fix error: ${String(e)}`);
        return false;
      }
    }

    const file = extractFileFromError(config.errorMsg);
    if (!file) {
      log('[AutoFix] Could not extract file from error: ' + config.errorMsg.slice(0, 120));
      return false;
    }

    try {
      const resp = await fetch(`/__read_preview?path=${encodeURIComponent(file)}`);
      if (!resp.ok) {
        log(`[AutoFix] Could not read ${file}: ${resp.status}`);
        return false;
      }
      const data = await resp.json() as { content?: string; ok?: boolean };
      if (!data.ok || !data.content) {
        log(`[AutoFix] No content for ${file}`);
        return false;
      }

      const fixPrompt = `You are fixing a React/TypeScript compilation error.

ERROR:
${config.errorMsg.slice(0, 800)}

FILE: ${file}
${data.content}

Output the COMPLETE fixed file using <!--FILE:${file}--> marker format.
Fix ONLY the error. Keep all existing functionality and imports.
Do not add comments explaining the fix.`;

      log(`[AutoFix] Calling fix agent for ${file}...`);
      const fixed = await callLLM(fixPrompt, '', 'fix', config.apiKey, undefined, config.signal);
      const fixedFiles = parseFileMarkers(fixed);

      if (Object.keys(fixedFiles).length === 0) {
        log('[AutoFix] No files parsed from fix response');
        return false;
      }

      for (const [path, content] of Object.entries(fixedFiles)) {
        if (!validateFile(path, content)) {
          log(`[AutoFix] Skipping invalid fix output for ${path}`);
          continue;
        }
        await writePreviewFile(path, content);
        log(`[AutoFix] ✓ Wrote fix: ${path}`);
      }
      return true;
    } catch (e: unknown) {
      if (e instanceof DOMException && e.name === 'AbortError') throw e;
      log(`[AutoFix] Error: ${String(e)}`);
      return false;
    }
  }
}

// Re-export types so useStudio import stays compatible
export type { GenerationResult, ProjectGraph };
