{
  "version": 1,
  "layout": "tabs",
  "routes": [
    {
      "path": "/",
      "component": "Page1",
      "filePath": "pages/Home.tsx",
      "title": "Page1",
      "isHome": true,
      "isProtected": true
    },
    {
      "path": "/event/:id",
      "component": "Page2",
      "filePath": "pages/EventDetails.tsx",
      "title": "Page2",
      "isHome": false,
      "isProtected": true
    },
    {
      "path": "/create-event",
      "component": "Page3",
      "filePath": "pages/CreateEvent.tsx",
      "title": "Page3",
      "isHome": false,
      "isProtected": true
    },
    {
      "path": "/my-events",
      "component": "Page4",
      "filePath": "pages/MyEvents.tsx",
      "title": "Page4",
      "isHome": false,
      "isProtected": true
    },
    {
      "path": "/account",
      "component": "Page5",
      "filePath": "pages/AccountSettings.tsx",
      "title": "Page5",
      "isHome": false,
      "isProtected": true
    }
  ]
}