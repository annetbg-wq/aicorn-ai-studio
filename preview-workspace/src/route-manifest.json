{
  "skeletonId": "mobile-app",
  "label": "Mobile App",
  "version": "0.2.0",
  "navigation": "bottom-tabs",
  "shell": "AppShell wraps OnboardingGuard + BottomTabs",
  "routes": [
    { "path": "/onboarding", "page": "src/pages/Onboarding.tsx", "guard": "GuestGuard" },
    { "path": "/home", "page": "src/pages/Home.tsx", "guard": "OnboardingGuard" },
    { "path": "/detail/:id", "page": "src/pages/Detail.tsx", "guard": "OnboardingGuard", "params": ["id"] },
    { "path": "/create", "page": "src/pages/Create.tsx", "guard": "OnboardingGuard" },
    { "path": "/progress", "page": "src/pages/Progress.tsx", "guard": "OnboardingGuard" },
    { "path": "/profile", "page": "src/pages/Profile.tsx", "guard": "OnboardingGuard" }
  ],
  "tabs": [
    { "to": "/home", "label": "Home" },
    { "to": "/create", "label": "Create", "primary": true },
    { "to": "/progress", "label": "Progress" },
    { "to": "/profile", "label": "Profile" }
  ],
  "providedComponents": [
    "ErrorBoundary",
    "LoadingScreen",
    "EmptyState",
    "BottomTabs",
    "PaywallSheet"
  ],
  "providedHooks": ["useApp", "useLocalStorage", "useTheme"],
  "uiPrimitives": [
    "Avatar",
    "Badge",
    "Button",
    "Card",
    "Dialog",
    "Input",
    "Progress",
    "Select",
    "Sheet",
    "Skeleton",
    "Tabs"
  ],
  "designTokens": [
    "--pm-canvas",
    "--pm-surface",
    "--pm-surface-soft",
    "--pm-ink",
    "--pm-muted",
    "--pm-line",
    "--pm-brand",
    "--pm-on-brand",
    "--pm-success",
    "--pm-warning",
    "--pm-rose",
    "--pm-violet",
    "--pm-overlay"
  ],
  "config": {
    "appIdentity": "src/config/app.ts",
    "routes": "src/config/routes.ts",
    "navigation": "src/config/navigation.ts",
    "theme": "src/config/theme.ts"
  },
  "placeholders": {
    "appName": "AppName — defined in src/config/app.ts → APP_CONFIG.name",
    "productMarkers": "/* PRODUCT: ... */ — copy and domain rewrites",
    "seedMarkers": "// SEED: ... — replace with real data source"
  }
}
